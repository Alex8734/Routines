<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- http_request: ausgehende HTTP-Aufrufe via HttpURLConnection -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Persistenter Foreground-Service der Engine -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Service-Notification (ab API 33 Runtime-Grant nötig) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- toggle_hotspot: WLAN-Status lesen/ändern (Standard-Pfad-Versuch vor Root-Fallback) -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- wifi_ssid: Auslesen der verbundenen SSID erfordert auf API 27+
         ACCESS_FINE_LOCATION + aktivierte Standortdienste; sonst liefert das
         Framework "<unknown ssid>" → wir emittieren null (graceful). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- bluetooth_device: Gerätename aus ACL-Broadcasts lesen. Ab API 31+
         BLUETOOTH_CONNECT (Runtime-Grant); auf API <=30 reicht legacy BLUETOOTH. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />

    <!-- set_brightness: System-Settings schreiben (Special Permission, Runtime-Grant via Settings.System.canWrite) -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <!-- toggle_dnd / set_volume_profile (silent): DND-Policy-Zugriff (Runtime-Grant) -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- fire_app_intent: Package-Sichtbarkeit für getLaunchIntentForPackage /
         resolveActivity auf API 30+ (sonst liefern beide null/false). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Routines">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Routines"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".core.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".core.MacroForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!-- Begründung für specialUse: generische Automatisierungs-Engine,
                 die keinem der vordefinierten FGS-Typen exakt entspricht. -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Automation rule engine reacting to device system events" />
        </service>
    </application>

</manifest>